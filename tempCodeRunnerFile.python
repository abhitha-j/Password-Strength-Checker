def check_length(password):
     return len(password)>=8
    
def check_uppercase(password):
     for i in password:
        if i.isupper():
            return True
     return False
def check_lowercase(password):
     for i in password:
        if i.islower():
            return True
     return False
def check_digit(password):
     for i in password:
      if i.isdigit():
        return True
     return False
def check_special(password):
     for i in password:
        if i in "@#$%&*!?_":
            return True
     return False
def check_space(password):
     if " " in password:
        return True
     return False
def main():
    password = input("Enter password: ")

    length_valid = check_length(password)
    uppercase_valid = check_uppercase(password)
    lowercase_valid = check_lowercase(password)
    digit_valid = check_digit(password)
    special_valid = check_special(password)
    space_found = check_space(password)

    if space_found:
     print("Invalid password: Spaces are not allowed")
    else:
     score=length_valid+uppercase_valid+lowercase_valid+digit_valid+special_valid
     print("password score :",score,"/5")
     if score<=2:
         print("weak")
     elif score<=4:
         print("moderate")
     else:
         print("strong")

main()